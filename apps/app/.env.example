# Copy to apps/app/.env (git-ignored) and fill in. Expo inlines EXPO_PUBLIC_*
# values into the app bundle, so only public values belong here: never a
# service-role key.

# Local Supabase (`pnpm db:start` prints both values).
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Error reporting stays off while this is empty.
EXPO_PUBLIC_SENTRY_DSN=

# 1 turns on end-to-end seams (for example "Use test photo"). Never set in production builds.
EXPO_PUBLIC_E2E=
