{
  "name": "pawpin",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck && tsc -p tools",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "verify": "pnpm typecheck && pnpm lint && pnpm test",
    "gen:tokens": "node tools/tokens/build-tokens.ts",
    "gen:stickers": "svgr --native --typescript --svgo-config tools/stickers/svgo.config.json --out-dir packages/ui/src/stickers/generated packages/ui/assets/stickers",
    "gen:sql-limits": "node packages/core/scripts/emit-sql-limits.ts",
    "gen:types": "supabase gen types typescript --local --schema api > packages/api/src/database.types.ts",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "test:db": "supabase test db",
    "test:functions": "deno test supabase/functions/_shared",
    "test:api": "pnpm --filter @pawpin/api test:int"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@svgr/cli": "8.1.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "globals": "17.13.0",
    "prettier": "^3.9.10",
    "supabase": "2.121.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
