# Copy to apps/app/.env (git-ignored) and fill in. Expo inlines EXPO_PUBLIC_*
# values into the app bundle, so only public values belong here: never a
# service-role key.
#
# For the hosted pilot these same names are EAS environment variables instead (the setup wizard,
# tools/setup/pilot-setup.sh, sets them). Nothing in this file is ever committed.

# Local Supabase (`pnpm db:start` prints both values).
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Error reporting stays off while this is empty.
EXPO_PUBLIC_SENTRY_DSN=

# Optional. A shared support address (not a personal one): when set, the "This pilot is
# invite-only" message offers a mailto: link to it, and with it empty the message has no link.
# Public: it is in the bundle.
EXPO_PUBLIC_SUPPORT_EMAIL=

# Optional, build time only (read by app.config.ts for the Sentry source-map upload, so not
# EXPO_PUBLIC_ and not in the bundle). An upload needs all three of SENTRY_AUTH_TOKEN, SENTRY_ORG
# and SENTRY_PROJECT: ORG and PROJECT are required as soon as the token is set. The token is a
# secret, so keep it in the EAS environment (as a secret), never in a file. With no token a build
# skips the upload.
# SENTRY_ORG=
# SENTRY_PROJECT=

# End-to-end seams (for example "Use test photo"): 1 turns them on. Do NOT set it here. Anything
# in this file reaches every local build, and the seams must never reach a hosted one. Pass it on
# the command line for the one build that needs it, for example the iOS development build that
# `pnpm test:e2e:ios` drives:
#   EXPO_PUBLIC_E2E=1 pnpm --filter @meoofy/app exec expo run:ios
# The web end-to-end tests (`pnpm test:e2e:web`) set it themselves, for their own export only.
# EXPO_PUBLIC_E2E=
