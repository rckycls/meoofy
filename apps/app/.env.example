# Copy to apps/app/.env (git-ignored) and fill in. Expo inlines EXPO_PUBLIC_*
# values into the app bundle, so only public values belong here: never a
# service-role key.

# Local Supabase (`pnpm db:start` prints both values).
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Error reporting stays off while this is empty.
EXPO_PUBLIC_SENTRY_DSN=

# Optional, build time only (read by app.config.ts for the Sentry source-map upload, so not
# EXPO_PUBLIC_ and not in the bundle). The upload also needs SENTRY_AUTH_TOKEN, which is a secret:
# keep it in the EAS environment, never in a file. With no token a build skips the upload.
# SENTRY_ORG=
# SENTRY_PROJECT=

# 1 turns on end-to-end seams (for example "Use test photo"). Never set in production builds. The
# web end-to-end tests (`pnpm test:e2e:web`) set it themselves, for their own export only; set it
# here only to build the iOS development build that `pnpm test:e2e:ios` drives.
EXPO_PUBLIC_E2E=
