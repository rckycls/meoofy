{
  "name": "@pawpin/app",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit && tsc -p e2e",
    "test": "jest",
    "test:e2e:web": "playwright test",
    "test:e2e:ios": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON e2e/support/run-maestro.ts",
    "deploy:web": "expo export --platform web && eas deploy --prod",
    "build:ios": "eas build -p ios --profile production",
    "submit:ios": "eas submit -p ios --latest"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "0.4.2",
    "@expo/metro-runtime": "58.0.15",
    "@pawpin/api": "workspace:*",
    "@pawpin/core": "workspace:*",
    "@pawpin/ui": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@sentry/react-native": "8.28.0",
    "@tanstack/query-async-storage-persister": "5.104.5",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-query-persist-client": "5.104.5",
    "expo": "58.0.17",
    "expo-apple-authentication": "58.0.2",
    "expo-asset": "58.0.18",
    "expo-blur": "58.0.5",
    "expo-camera": "58.0.12",
    "expo-constants": "58.0.13",
    "expo-crypto": "58.0.7",
    "expo-dev-client": "58.0.14",
    "expo-font": "58.0.9",
    "expo-image-manipulator": "58.0.15",
    "expo-image-picker": "58.0.10",
    "expo-linear-gradient": "58.0.3",
    "expo-linking": "58.0.14",
    "expo-router": "58.0.25",
    "expo-secure-store": "58.0.2",
    "expo-splash-screen": "58.0.11",
    "jpeg-js": "0.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@react-native/jest-preset": "0.88.0",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "jest": "30.5.2",
    "jest-expo": "58.0.12",
    "pg": "8.23.1",
    "test-renderer": "1.3.1"
  }
}
